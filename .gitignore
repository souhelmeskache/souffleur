# --- secrets / local env ---
.env
.venv/
venv/

# --- Claude Code local settings (permissions posées par worktree, non partagées) ---
.claude/settings.local.json

# --- python ---
__pycache__/
*.pyc

# --- user data (auto-seeded on first run; never ship or track) ---
saves/
scenarios/
instructions/
characters.json
library.json
config.yaml

# --- runtime turn scratch: holds the assembled play context (campaign material) ---
.turn/

# --- banc de fumée (D-264): journal par tour, peut citer la fiction du banc
# DKS (module sacrificiel D-109/D-178) -- rien de cette fiction ne se
# versionne, même le journal mécanique qui la cite ---
bench/banc-fumee/

# --- banc de nuit (#201/#260) : mêmes raisons -- copies de save + journaux
# par partie peuvent citer le module sacrificiel joué, rien ne se versionne ---
bench/nuit-*/

# --- run de fumée/journée (#309) : dossier par défaut de nuit.sh sans -FinA,
# séparé de bench/nuit-*/ pour ne plus polluer la continuation d'une vraie
# nuit -- mêmes raisons que bench/nuit-*/ ci-dessus ---
bench/fumee-*/

# --- verrou de création du workspace herdr dédié au banc (#298) : mkdir
# atomique, transitoire (retiré en fin d'appel), jamais du matériau ---
bench/.verrou-workspace-banc/

# --- verrous de veille par issue (#323) : pid/depuis/phase de circuit.sh
# veiller, transitoires (retirés au trap EXIT), jamais du matériau ---
bench/.veilles/

# --- garde core.bare (I-231/#255) : journal machine (horodatage, origine,
# commande en cours), pas du matériau à versionner ---
tools/banc/core-bare.log

# --- P4 converter input corpus: extracted module text + measures (campaign material) ---
corpus-modules/

# --- build outputs (PyInstaller) ---
build/
dist/
*.spec

# --- local working material (not part of the product) ---
working ideas screenshots/
spike/
*.zip

# --- internal working docs (kept local, not part of the public repo) ---
HANDOFF.md
SPEC-V2.md
ROADMAP.md
DISTRIBUTION-PLAN.md
SILLYTAVERN-IMPROVEMENT-PLAN.md
